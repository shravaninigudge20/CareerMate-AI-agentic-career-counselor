# Watsonx.ai / IBM Granite Configuration
# Add your IBM Cloud API Key and Watsonx Project ID here to use live IBM Granite models.
# If left blank, the application will automatically fall back to a high-fidelity local simulator.
WATSONX_API_KEY=
WATSONX_PROJECT_ID=
WATSONX_URL=https://us-south.ml.cloud.ibm.com
WATSONX_MODEL_ID=ibm/granite-13b-chat-v2

# Database Configuration
DATABASE_URL=sqlite:///./data/careermate.db

# Security & Authentication
JWT_SECRET=super_secret_careermate_key_change_me_in_production_12345
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
